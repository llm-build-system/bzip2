type = "static-library"
name = "bz2"
standards = ["C11"]

[defines]
private = ["_FILE_OFFSET_BITS=64"]

[windows.defines]
private = ["_CRT_SECURE_NO_WARNINGS", "_CRT_NONSTDC_NO_DEPRECATE"]

[linux.defines]
private = ["_POSIX_C_SOURCE=200809L"]

[macos.defines]
private = ["_POSIX_C_SOURCE=200809L"]
